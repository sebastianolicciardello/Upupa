---
import Layout from '../layouts/Layout.astro';
import SplitScreen from '../components/SplitScreen.astro';
import SplitPane from '../components/SplitPane.astro';
import { t } from '../utils/i18n';

const lang = 'it' as const;

// Background image candidates for each pane (Cloudinary originals, resized on delivery).
const candidates = {
  horizon: [
    'https://res.cloudinary.com/digfarmqt/image/upload/f_auto,q_auto,c_limit,w_1600/v1793121401/thenomadupupa/changing-pace/05-etna4-il-luogo-difficile.jpg',
    'https://res.cloudinary.com/digfarmqt/image/upload/f_auto,q_auto,c_limit,w_1600/v1783408818/PXL_20250830_193525313.NIGHT_ucs5jq.jpg',
    'https://res.cloudinary.com/digfarmqt/image/upload/f_auto,q_auto,c_limit,w_1600/v1783408823/PXL_20250824_131511805_eibasw.jpg',
  ],
  journal: [
    'https://res.cloudinary.com/digfarmqt/image/upload/f_auto,q_auto,c_limit,w_1600/v1794576399/io_nella_cascata_-_foto_copertina_uyh9yu.jpg',
    'https://res.cloudinary.com/digfarmqt/image/upload/f_auto,q_auto,c_limit,w_1600/v1783408822/PXL_20250831_043414609.MP_d6szpr.jpg',
    'https://res.cloudinary.com/digfarmqt/image/upload/f_auto,q_auto,c_limit,w_1600/v1783408817/PXL_20250727_070001417_yyfywc.jpg',
  ],
};

// Pick the first reachable image at build time; undefined means the pane falls
// back to a soft gradient so the home page never ends up with a broken image.
async function firstReachable(urls: string[]) {
  for (const url of urls) {
    try {
      const res = await fetch(url, { method: 'HEAD' });
      if (res.ok) return url;
    } catch {
      // ignore and try the next candidate
    }
  }
  return undefined;
}

const [horizonImage, journalImage] = await Promise.all([
  firstReachable(candidates.horizon),
  firstReachable(candidates.journal),
]);

const panes = [
  {
    href: '/horizon/',
    image: horizonImage,
    title: 'home.horizon.title',
    subtitle: 'home.horizon.subtitle',
    description: 'home.horizon.description',
    cta: 'home.horizon.cta',
  },
  {
    href: '/journal/',
    image: journalImage,
    title: 'home.journal.title',
    subtitle: 'home.journal.subtitle',
    description: 'home.journal.description',
    cta: 'home.journal.cta',
  },
];
---

<Layout title="Upupa · Horizon & Journal" isHome={true} lang="it" singleLanguage navContext="hub">
  <SplitScreen>
    {panes.map((pane) => (
      <div class="split-pane-wrap">
        <SplitPane
          href={pane.href}
          image={pane.image}
          title={t(pane.title, lang)}
          eyebrow={t(pane.subtitle, lang)}
          description={t(pane.description, lang)}
          cta={t(pane.cta, lang)}
        />
      </div>
    ))}
  </SplitScreen>
</Layout>
