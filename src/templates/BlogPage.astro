---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostsList from '../components/PostsList.astro';
import SortButton from '../components/SortButton.astro';
import ReadingGuide from '../components/ReadingGuide.astro';
import UnderConstructionNotice from '../components/UnderConstructionNotice.astro';
import { getCollection } from 'astro:content';
import { t, type Language } from '../utils/i18n';

export interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;

// Get posts based on language
const allPosts = await getCollection('posts');

// Helper function to resolve multilingual frontmatter
function resolveMultilingualData(data: any, targetLang: Language) {
  const resolved = { ...data };
  Object.keys(resolved).forEach(key => {
    const value = resolved[key];
    if (typeof value === 'object' && value !== null && !Array.isArray(value) && !value.lat) {
      if (value[targetLang]) {
        resolved[key] = value[targetLang];
      } else if (value.en) {
        resolved[key] = value.en; // Fallback to English
      }
    }
  });
  return resolved;
}

// Process posts for both languages
const processedPostsEn = allPosts.flatMap(post => {
  if (post.slug.startsWith('en/')) {
    return [{
      ...post,
      data: { ...post.data, lang: 'en' as Language }
    }];
  } else if (!post.slug.startsWith('en/') && !post.slug.startsWith('it/')) {
    if (post.body.includes('<!-- en -->') || post.body.includes('<!-- it -->')) {
      const resolvedData = resolveMultilingualData(post.data, 'en');
      resolvedData.lang = 'en';
      return [{
        ...post,
        data: resolvedData
      }];
    } else {
      return [{
        ...post,
        data: { ...post.data, lang: 'en' as Language }
      }];
    }
  }
  return [];
});

const processedPostsIt = allPosts.flatMap(post => {
  if (post.slug.startsWith('it/')) {
    return [{
      ...post,
      data: { ...post.data, lang: 'it' as Language }
    }];
  } else if (!post.slug.startsWith('en/') && !post.slug.startsWith('it/')) {
    if (post.body.includes('<!-- en -->') || post.body.includes('<!-- it -->')) {
      const resolvedData = resolveMultilingualData(post.data, 'it');
      resolvedData.lang = 'it';
      return [{
        ...post,
        data: resolvedData
      }];
    }
  }
  return [];
});

// Both eras are listed newest first: the sort button then flips them on demand.
const sortedPostsEn = processedPostsEn.sort((a, b) =>
  b.data.eventStartTime.getTime() - a.data.eventStartTime.getTime()
);

const sortedPostsIt = processedPostsIt.sort((a, b) =>
  b.data.eventStartTime.getTime() - a.data.eventStartTime.getTime()
);

// The archive is split in two eras by the *event* date (when the moment happened),
// not by the publication date: the historical "Nomad Upupa" period holds the
// moments lived before 23 February 2026, the recent section the ones after it.
const NOMAD_ERA_END = new Date('2026-02-23T00:00:00Z').getTime();

function splitByEra(posts: any[]) {
  return {
    recent: posts
      .filter(post => post.data.eventStartTime.getTime() >= NOMAD_ERA_END)
      .sort((a, b) => b.data.eventStartTime.getTime() - a.data.eventStartTime.getTime()),
    nomad: posts
      .filter(post => post.data.eventStartTime.getTime() < NOMAD_ERA_END)
      .sort((a, b) => b.data.eventStartTime.getTime() - a.data.eventStartTime.getTime()),
  };
}

const erasEn = splitByEra(sortedPostsEn);
const erasIt = splitByEra(sortedPostsIt);
---

<Layout title="Archivio · Upupa" navContext="journal">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- English Version -->
    <div data-lang="en">
      <PageHeader
        title={t('blog.title', 'en')}
        description={t('blog.description', 'en')}
      />

      <!-- Reading Guide -->
      <ReadingGuide lang="en" />

      <!-- Recent posts: hidden entirely while nothing has been lived after the era -->
      {erasEn.recent.length > 0 && (
        <>
          <SortButton id="sortButton-en" target="postsList-en" lang="en" />

          <section class="mb-16">
            <h2 class="text-xl sm:text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-2">
              {t('blog.era.recent.title', 'en')}
            </h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
              {t('blog.era.recent.description', 'en')}
            </p>

            <div id="postsList-en">
              <PostsList
                posts={erasEn.recent}
                lang="en"
                dataLang="en"
                emptyMessage={t('blog.empty', 'en')}
              />
            </div>
          </section>
        </>
      )}

      <!-- Historical era: The Nomad Upupa -->
      <section id="nomad-upupa" class="scroll-mt-24 border-t border-gray-200 dark:border-gray-700 pt-10">
        <h2 class="text-xl sm:text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-2">
          {t('blog.era.nomad.title', 'en')}
        </h2>
        <div class="mb-6 max-w-2xl">
          <UnderConstructionNotice
            lang="en"
            detail={t('blog.era.nomad.pendingDetail', 'en')}
          />
        </div>

        <!-- Sort Button (Nomad Upupa era) -->
        <SortButton id="sortButton-nomad-en" target="postsList-nomad-en" lang="en" />

        <div id="postsList-nomad-en">
          <PostsList
            posts={erasEn.nomad}
            lang="en"
            dataLang="en"
            emptyMessage={t('nomadArchive.empty', 'en')}
          />
        </div>
      </section>
    </div>

    <!-- Italian Version -->
    <div data-lang="it" style="display: none;">
      <PageHeader
        title={t('blog.title', 'it')}
        description={t('blog.description', 'it')}
      />

      <!-- Reading Guide -->
      <ReadingGuide lang="it" />

      <!-- Recent posts: hidden entirely while nothing has been lived after the era -->
      {erasIt.recent.length > 0 && (
        <>
          <SortButton id="sortButton-it" target="postsList-it" lang="it" />

          <section class="mb-16">
            <h2 class="text-xl sm:text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-2">
              {t('blog.era.recent.title', 'it')}
            </h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
              {t('blog.era.recent.description', 'it')}
            </p>

            <div id="postsList-it">
              <PostsList
                posts={erasIt.recent}
                lang="it"
                dataLang="it"
                emptyMessage={t('blog.empty', 'it')}
              />
            </div>
          </section>
        </>
      )}

      <!-- Historical era: The Nomad Upupa -->
      <section id="nomad-upupa" class="scroll-mt-24 border-t border-gray-200 dark:border-gray-700 pt-10">
        <h2 class="text-xl sm:text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-2">
          {t('blog.era.nomad.title', 'it')}
        </h2>
        <div class="mb-6 max-w-2xl">
          <UnderConstructionNotice
            lang="it"
            detail={t('blog.era.nomad.pendingDetail', 'it')}
          />
        </div>

        <!-- Sort Button (Nomad Upupa era) -->
        <SortButton id="sortButton-nomad-it" target="postsList-nomad-it" lang="it" />

        <div id="postsList-nomad-it">
          <PostsList
            posts={erasIt.nomad}
            lang="it"
            dataLang="it"
            emptyMessage={t('nomadArchive.empty', 'it')}
          />
        </div>
      </section>
    </div>
  </div>
</Layout>
