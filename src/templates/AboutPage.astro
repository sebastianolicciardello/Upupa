---
import Layout from '../layouts/Layout.astro';
import ConnectLinks from '../components/ConnectLinks.astro';
import { t, type Language } from '../utils/i18n';

export interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
---

<Layout title="About · Upupa">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back to Hub / Breadcrumb -->
    <div class="mb-8">
      <a href="/" class="inline-flex items-center text-sm text-gray-500 hover:text-warm-700 dark:text-gray-400 dark:hover:text-warm-400 transition-colors">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>upupa.life</span>
      </a>
    </div>

    <div class="max-w-3xl mx-auto">
      <!-- English Version -->
      <div data-lang="en">
        <!-- Header -->
        <div class="text-center mb-10">
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-4">
            {t('about.title', 'en')}
          </h1>
          <p class="text-lg text-gray-500 dark:text-gray-400 italic font-serif">
            The mind behind Upupa, Horizon & Diary.
          </p>
        </div>

        <!-- Under Construction Notice Box -->
        <div class="p-8 md:p-10 rounded-2xl bg-warm-50/80 dark:bg-zinc-900/80 border-2 border-dashed border-warm-300 dark:border-zinc-700 text-center mb-12">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-warm-100 dark:bg-warm-900/50 text-warm-700 dark:text-warm-300 text-2xl mb-4">
            ✍️
          </div>
          <h2 class="text-xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-2">
            Section Ready to be Written
          </h2>
          <p class="text-gray-600 dark:text-gray-400 max-w-lg mx-auto text-sm leading-relaxed mb-6">
            This space is currently waiting for your personal story, travels, philosophies, and background. It will be updated soon.
          </p>
          <div class="p-4 rounded-xl bg-white dark:bg-zinc-950/60 border border-warm-200/80 dark:border-zinc-800 text-xs text-gray-500 dark:text-gray-400 max-w-md mx-auto text-left font-mono">
            <span class="font-bold text-warm-700 dark:text-warm-400">TODO:</span> Insert bio, background, travel milestones, and vision for Upupa.
          </div>
        </div>

        <!-- Social Links -->
        <ConnectLinks 
          connectTitle={t('connect.title', 'en')}
          telegramLabel={t('connect.telegram', 'en')}
          channelLabel={t('connect.channel', 'en')}
          instagramLabel={t('connect.instagram', 'en')}
        />
      </div>

      <!-- Italian Version -->
      <div data-lang="it" style="display: none;">
        <!-- Header -->
        <div class="text-center mb-10">
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-4">
            {t('about.title', 'it')}
          </h1>
          <p class="text-lg text-gray-500 dark:text-gray-400 italic font-serif">
            Chi c'è dietro Upupa, Horizon & Diary.
          </p>
        </div>

        <!-- Box Avviso Sezione Vuota da Compilare -->
        <div class="p-8 md:p-10 rounded-2xl bg-warm-50/80 dark:bg-zinc-900/80 border-2 border-dashed border-warm-300 dark:border-zinc-700 text-center mb-12">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-warm-100 dark:bg-warm-900/50 text-warm-700 dark:text-warm-300 text-2xl mb-4">
            ✍️
          </div>
          <h2 class="text-xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-2">
            Sezione in Preparazione
          </h2>
          <p class="text-gray-600 dark:text-gray-400 max-w-lg mx-auto text-sm leading-relaxed mb-6">
            Questo spazio è attualmente vuoto ed è pronto per essere compilato con la tua presentazione personale, le esperienze di viaggio e la visione di Upupa.
          </p>
          <div class="p-4 rounded-xl bg-white dark:bg-zinc-950/60 border border-warm-200/80 dark:border-zinc-800 text-xs text-gray-500 dark:text-gray-400 max-w-md mx-auto text-left font-mono">
            <span class="font-bold text-warm-700 dark:text-warm-400">DA COMPILARE:</span> Inserire biografia, percorso personale, tappe di viaggio e filosofia di vita.
          </div>
        </div>

        <!-- Social Links -->
        <ConnectLinks 
          connectTitle={t('connect.title', 'it')}
          telegramLabel={t('connect.telegram', 'it')}
          channelLabel={t('connect.channel', 'it')}
          instagramLabel={t('connect.instagram', 'it')}
        />
      </div>
    </div>
  </div>
</Layout>
