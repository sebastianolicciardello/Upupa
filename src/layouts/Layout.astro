---
import { getCurrentLanguage, t, getAlternateLanguage, type Language } from '../utils/i18n';
import '../styles/global.css';

export interface Props {
	title?: string;
	lang?: Language;
	isHome?: boolean;
	/**
	 * If true the page is rendered in a single language (the one passed via `lang`)
	 * and the language toggle is hidden. If false (default) the page is bilingual
	 * and the toggle is shown.
	 */
	singleLanguage?: boolean;
}

const { title, lang, isHome = false, singleLanguage = false } = Astro.props;
// Bilingual pages are rendered in English on the server and switch dynamically on the
// client (saved preference first, then the device language). Single-language pages are
// always rendered in `lang` (Italian by default).
const currentLang: Language = singleLanguage ? (lang ?? 'it') : 'en';
const pageTitle = title || t('page.title', currentLang);
// Languages rendered in the navigation: both for bilingual pages, one for single-language pages.
const navLangs: Language[] = singleLanguage ? [currentLang] : ['en', 'it'];
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth" style="visibility: hidden;" data-lang-loading="true">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet">
		<title>{pageTitle}</title>
		<style>
			/* Pre-hide wrong language content to prevent flash */
			html[data-initial-lang="it"] [data-lang="en"] { display: none !important; }
			html[data-initial-lang="en"] [data-lang="it"] { display: none !important; }
			/* Show correct language content immediately */
			html[data-initial-lang="it"] [data-lang="it"] { display: block !important; }
			html[data-initial-lang="en"] [data-lang="en"] { display: block !important; }
		</style>
		<script is:inline define:vars={{ isSingleLanguage: singleLanguage, initialLang: currentLang }}>
			// Runs before paint: resolve language and theme to avoid any flash.
			(function() {
				const root = document.documentElement;

				// --- Language ---
				if (isSingleLanguage) {
					// Single-language page: always use the language rendered by the server
					root.setAttribute('data-initial-lang', initialLang);
				} else {
					// Saved preference wins, otherwise follow the device language
					const savedLang = localStorage.getItem('language-preference');
					if (savedLang === 'it' || savedLang === 'en') {
						root.setAttribute('data-initial-lang', savedLang);
					} else {
						const deviceLangs = navigator.languages && navigator.languages.length
							? navigator.languages
							: [navigator.language || ''];
						const isItalian = deviceLangs.some(l => String(l).toLowerCase().startsWith('it'));
						root.setAttribute('data-initial-lang', isItalian ? 'it' : 'en');
					}
				}

				// --- Theme ---
				// Saved preference wins, otherwise follow the device appearance
				const savedTheme = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const isDark = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme === 'dark' : prefersDark;
				root.classList.toggle('dark', isDark);
			})();
		</script>
	</head>
	<body class="bg-warm-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 font-sans antialiased min-h-screen transition-colors duration-200">
		<nav class="bg-white dark:bg-zinc-900 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-16">
					<a href="/" class="flex items-center space-x-2 text-xl font-serif font-bold text-gray-900 dark:text-gray-100 hover:text-warm-600 dark:hover:text-warm-400 transition-colors">
						<span>Upupa</span>
					</a>
					
					<!-- Desktop Navigation -->
					<div class="hidden md:flex items-center space-x-6">
						{isHome ? (
							<>
								{navLangs.map((l, i) => (
									<span data-lang={l} style={i === 0 ? undefined : 'display: none;'}>
										<a href="/about/" class="text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 transition-colors font-medium">{t('nav.about', l)}</a>
									</span>
								))}
							</>
						) : (
							<>
								{navLangs.map((l, i) => (
									<span data-lang={l} style={i === 0 ? undefined : 'display: none;'} class="flex items-center space-x-6">
										<a href="/horizon/" class="text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 transition-colors font-medium">{t('nav.horizon', l)}</a>
										<a href="/journal/" class="text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 transition-colors font-medium">{t('nav.journal', l)}</a>
										<a href="/journal/blog/" class="text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 transition-colors">{t('nav.archive', l)}</a>
										<a href="/about/" class="text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 transition-colors">{t('nav.about', l)}</a>
									</span>
								))}
							</>
						)}
						{!singleLanguage && (
							<button id="lang-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" aria-label="Switch language">
								<span class="text-sm font-medium" id="lang-button-text">
									<span data-lang="en">IT</span>
									<span data-lang="it" style="display: none;">EN</span>
								</span>
							</button>
						)}
						<button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" aria-label="Toggle theme">
							<svg id="theme-toggle-light-icon" class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
							</svg>
							<svg id="theme-toggle-dark-icon" class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20">
								<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
							</svg>
						</button>
					</div>

					<!-- Mobile Navigation -->
					<div class="md:hidden">
						<button id="mobile-menu-button" class="p-2 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors" aria-label="Open menu">
							<svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
							</svg>
							<svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
				</div>

				<!-- Mobile Menu -->
				<div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-zinc-900">
					<div class="px-2 pt-2 pb-3 space-y-1">
						{isHome ? (
							<>
								{navLangs.map((l, i) => (
									<span data-lang={l} style={i === 0 ? undefined : 'display: none;'}>
										<a href="/about/" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors font-medium">{t('nav.about', l)}</a>
									</span>
								))}
							</>
						) : (
							<>
								{navLangs.map((l, i) => (
									<span data-lang={l} style={i === 0 ? undefined : 'display: none;'}>
										<a href="/horizon/" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors font-medium">{t('nav.horizon', l)}</a>
										<a href="/journal/" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors font-medium">{t('nav.journal', l)}</a>
										<a href="/journal/blog/" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors">{t('nav.archive', l)}</a>
										<a href="/about/" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-warm-600 dark:hover:text-warm-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-md transition-colors">{t('nav.about', l)}</a>
									</span>
								))}
							</>
						)}
						
						<!-- Settings separator -->
						<div class="border-t border-gray-200 dark:border-gray-700 my-2"></div>
						
						<!-- Language and Theme toggles -->
						<div class="px-3 py-2 space-y-3">
							{!singleLanguage && (
								<div class="flex items-center justify-between">
									<span class="text-sm text-gray-600 dark:text-gray-400">
										<span data-lang="en">{t('settings.language', 'en')}</span>
										<span data-lang="it" style="display: none;">{t('settings.language', 'it')}</span>
									</span>
									<button id="lang-toggle-mobile" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" aria-label="Switch language">
										<span class="text-sm font-medium" id="lang-button-text-mobile">
											<span data-lang="en">IT</span>
											<span data-lang="it" style="display: none;">EN</span>
										</span>
									</button>
								</div>
							)}
							<div class="flex items-center justify-between">
								<span class="text-sm text-gray-600 dark:text-gray-400">
									{navLangs.map((l, i) => (
										<span data-lang={l} style={i === 0 ? undefined : 'display: none;'}>{t('settings.theme', l)}</span>
									))}
								</span>
								<button id="theme-toggle-mobile" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors" aria-label="Toggle theme">
									<svg id="theme-toggle-light-icon-mobile" class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
									</svg>
									<svg id="theme-toggle-dark-icon-mobile" class="w-5 h-5 block dark:hidden" fill="currentColor" viewBox="0 0 20 20">
										<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
									</svg>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</nav>
		<main class="flex-1">
			<slot />
		</main>
		<footer class:list={[
			"bg-white dark:bg-zinc-900 border-t border-gray-200 dark:border-gray-700",
			{ 'mt-16': !isHome }
		]}>
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
				<div class="flex flex-col items-center justify-center text-center">
					<div class="text-xs text-gray-400 dark:text-gray-500 w-full text-center">
						{navLangs.map((l, i) => (
							<p data-lang={l} style={i === 0 ? undefined : 'display: none;'}>&copy; {t('footer.copyright', l)}</p>
						))}
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<script define:vars={{ SINGLE_LANGUAGE: singleLanguage, SSR_LANGUAGE: currentLang }}>
	// Returns a valid stored language, or null when the user never picked one.
	function getStoredLanguage() {
		const saved = localStorage.getItem('language-preference');
		return saved === 'it' || saved === 'en' ? saved : null;
	}

	// First visit: follow the device/system language settings (Italian if any of them is Italian).
	function getDeviceLanguage() {
		const deviceLangs = navigator.languages && navigator.languages.length
			? navigator.languages
			: [navigator.language || ''];
		return deviceLangs.some(l => String(l).toLowerCase().startsWith('it')) ? 'it' : 'en';
	}

	function getCurrentLanguage() {
		return getStoredLanguage() || getDeviceLanguage();
	}
	
	function updateLanguageContent(lang) {
		// Hide all language-specific content
		document.querySelectorAll('[data-lang]').forEach(el => {
			el.style.display = 'none';
		});
		
		// Show content for current language
		document.querySelectorAll(`[data-lang="${lang}"]`).forEach(el => {
			el.style.display = '';
		});
		
		// Update page title for multilingual posts
		if (window.postTitles && window.postTitles[lang]) {
			document.title = window.postTitles[lang];
		}
		
		// Update document attributes
		document.documentElement.setAttribute('lang', lang);
		document.documentElement.setAttribute('data-language', lang);
		document.documentElement.setAttribute('data-initial-lang', lang);
	}

	// Bilingual pages honour the saved/detected language, single-language pages
	// always stay on the language rendered by the server.
	function resolvePageLanguage() {
		return SINGLE_LANGUAGE ? SSR_LANGUAGE : getCurrentLanguage();
	}
	
	function setLanguage(lang) {
		localStorage.setItem('language-preference', lang);
		updateLanguageContent(lang);
	}
	
	// Expose functions globally for other components
	window.updateLanguageContent = updateLanguageContent;
	window.getCurrentLanguage = resolvePageLanguage;
	window.setLanguage = setLanguage;
	
	// Initialize language system when DOM is ready
	document.addEventListener('DOMContentLoaded', () => {
		const currentLang = resolvePageLanguage();
		updateLanguageContent(currentLang);
		// Show page after language is set
		document.documentElement.style.visibility = 'visible';
		document.documentElement.removeAttribute('data-lang-loading');
		
		// Language toggle functionality - moved inside DOMContentLoaded
		const langToggle = document.getElementById('lang-toggle');
		const langToggleMobile = document.getElementById('lang-toggle-mobile');
		
		function handleLanguageToggle() {
			const currentLang = resolvePageLanguage();
			const newLang = currentLang === 'en' ? 'it' : 'en';
			setLanguage(newLang);
		}
		
		langToggle?.addEventListener('click', handleLanguageToggle);
		langToggleMobile?.addEventListener('click', handleLanguageToggle);
	});

	// Theme toggle functionality
	// The initial theme (saved preference, otherwise the device appearance) is already
	// applied pre-paint by the inline script in <head> to avoid a flash.
	const themeToggle = document.getElementById('theme-toggle');
	const themeToggleMobile = document.getElementById('theme-toggle-mobile');
	const html = document.documentElement;

	function toggleTheme() {
		html.classList.toggle('dark');
		localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
	}
	
	// Theme toggle for desktop
	themeToggle?.addEventListener('click', toggleTheme);
	
	// Theme toggle for mobile
	themeToggleMobile?.addEventListener('click', toggleTheme);
	
	// Mobile menu functionality
	const mobileMenuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');
	const menuOpenIcon = document.getElementById('menu-open-icon');
	const menuCloseIcon = document.getElementById('menu-close-icon');
	
	mobileMenuButton?.addEventListener('click', () => {
		const isHidden = mobileMenu?.classList.contains('hidden');
		
		if (isHidden) {
			mobileMenu?.classList.remove('hidden');
			menuOpenIcon?.classList.add('hidden');
			menuCloseIcon?.classList.remove('hidden');
		} else {
			mobileMenu?.classList.add('hidden');
			menuOpenIcon?.classList.remove('hidden');
			menuCloseIcon?.classList.add('hidden');
		}
	});
	
	// Close mobile menu when clicking on a link
	const mobileMenuLinks = mobileMenu?.querySelectorAll('a');
	mobileMenuLinks?.forEach(link => {
		link.addEventListener('click', () => {
			mobileMenu?.classList.add('hidden');
			menuOpenIcon?.classList.remove('hidden');
			menuCloseIcon?.classList.add('hidden');
		});
	});
</script>