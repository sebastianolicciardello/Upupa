---
import { t, type Language } from '../utils/i18n';

export interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div>
  <!-- Dual Cards Grid: Horizon vs Journal -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 lg:gap-10">
    <!-- Horizon Card -->
    <div class="group relative flex flex-col justify-between p-8 sm:p-10 rounded-2xl bg-gradient-to-b from-white to-gray-50/50 dark:from-zinc-900 dark:to-zinc-950 border border-gray-200 dark:border-zinc-800 hover:border-warm-400 dark:hover:border-warm-500 shadow-sm hover:shadow-xl transition-all duration-300">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wider uppercase rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
            {t('home.horizon.badge', lang)}
          </span>
          <span class="text-2xl opacity-60 group-hover:opacity-100 transition-opacity">🧭</span>
        </div>

        <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-2">
          {t('home.horizon.title', lang)}
        </h2>
        <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-5">
          {t('home.horizon.subtitle', lang)}
        </p>
        <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-base mb-6">
          {t('home.horizon.description', lang)}
        </p>

        <!-- Horizon Pillars Preview -->
        <ul class="space-y-2 mb-8 text-sm text-gray-500 dark:text-gray-400">
          <li class="flex items-center gap-2">
            <span class="text-blue-500">→</span>
            <span>{t('horizon.pillar1.title', lang)}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-blue-500">→</span>
            <span>{t('horizon.pillar2.title', lang)}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-blue-500">→</span>
            <span>{t('horizon.pillar3.title', lang)}</span>
          </li>
        </ul>
      </div>

      <div>
        <a 
          href="/horizon/" 
          class="inline-flex items-center justify-center w-full px-6 py-3.5 rounded-xl text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white shadow-sm transition-all duration-200 group-hover:translate-x-0.5"
        >
          <span>{t('home.horizon.cta', lang)}</span>
          <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Journal Card -->
    <div class="group relative flex flex-col justify-between p-8 sm:p-10 rounded-2xl bg-gradient-to-b from-white to-warm-50/30 dark:from-zinc-900 dark:to-zinc-950 border border-gray-200 dark:border-zinc-800 hover:border-warm-500 dark:hover:border-warm-400 shadow-sm hover:shadow-xl transition-all duration-300">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wider uppercase rounded-full bg-warm-100 dark:bg-warm-950/60 text-warm-800 dark:text-warm-300 border border-warm-200 dark:border-warm-800">
            {t('home.journal.badge', lang)}
          </span>
          <span class="text-2xl opacity-60 group-hover:opacity-100 transition-opacity">📖</span>
        </div>

        <h2 class="text-3xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-2">
          {t('home.journal.title', lang)}
        </h2>
        <p class="text-sm font-medium text-warm-700 dark:text-warm-400 mb-5">
          {t('home.journal.subtitle', lang)}
        </p>
        <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-base mb-6">
          {t('home.journal.description', lang)}
        </p>

        <!-- Journal Pillars Preview -->
        <ul class="space-y-2 mb-8 text-sm text-gray-500 dark:text-gray-400">
          <li class="flex items-center gap-2">
            <span class="text-warm-600 dark:text-warm-400">→</span>
            <span>{lang === 'it' ? 'Riflessioni lente dal viaggio' : 'Slow travel reflections'}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-warm-600 dark:text-warm-400">→</span>
            <span>{lang === 'it' ? 'Tracce musicali e colonna sonora' : 'YouTube Music soundtrack embedded'}</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-warm-600 dark:text-warm-400">→</span>
            <span>{lang === 'it' ? 'Flusso emozionale e cronologico' : 'Emotional & chronological reading flow'}</span>
          </li>
        </ul>
      </div>

      <div>
        <a 
          href="/journal/" 
          class="inline-flex items-center justify-center w-full px-6 py-3.5 rounded-xl text-sm font-medium text-white bg-warm-700 hover:bg-warm-800 dark:bg-warm-600 dark:hover:bg-warm-500 shadow-sm transition-all duration-200 group-hover:translate-x-0.5"
        >
          <span>{t('home.journal.cta', lang)}</span>
          <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
