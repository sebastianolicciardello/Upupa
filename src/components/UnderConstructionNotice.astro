---
import { t, type Language } from '../utils/i18n';

export interface Props {
  lang?: Language;
  detail?: string;
}

const { lang = 'it', detail } = Astro.props;
---

<div class="p-8 sm:p-12 rounded-2xl bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 shadow-sm">
  <div class="w-12 h-12 mx-auto mb-4 text-warm-600 dark:text-warm-400">
    <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
    </svg>
  </div>
  <p class="text-lg font-serif italic text-gray-700 dark:text-gray-300 mb-3">
    {t('common.underConstruction.title', lang)}
  </p>
  <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
    {detail ?? t('common.underConstruction.description', lang)}
  </p>
</div>
