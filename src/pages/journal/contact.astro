---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contatti · Upupa Journal" navContext="journal">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- English Version -->
    <div data-lang="en">
      <div class="max-w-2xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-warm-100 dark:bg-warm-950/60 text-warm-800 dark:text-warm-300 border border-warm-200 dark:border-warm-800 text-xs font-semibold tracking-wider uppercase mb-6">
          <span>Upupa Journal</span>
        </div>

        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-6">
          Contact
        </h1>

        <div class="p-8 sm:p-12 rounded-2xl bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 shadow-sm mt-8">
          <div class="w-12 h-12 mx-auto mb-4 text-warm-600 dark:text-warm-400">
            <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <p class="text-lg font-serif italic text-gray-700 dark:text-gray-300 mb-3">
            Page under construction
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            This section is currently being prepared. Soon you will find all the details to get in touch with Upupa Journal here.
          </p>
        </div>
      </div>
    </div>

    <!-- Italian Version -->
    <div data-lang="it" style="display: none;">
      <div class="max-w-2xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-warm-100 dark:bg-warm-950/60 text-warm-800 dark:text-warm-300 border border-warm-200 dark:border-warm-800 text-xs font-semibold tracking-wider uppercase mb-6">
          <span>Upupa Journal</span>
        </div>

        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-6">
          Contatti
        </h1>

        <div class="p-8 sm:p-12 rounded-2xl bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 shadow-sm mt-8">
          <div class="w-12 h-12 mx-auto mb-4 text-warm-600 dark:text-warm-400">
            <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <p class="text-lg font-serif italic text-gray-700 dark:text-gray-300 mb-3">
            Pagina in compilazione
          </p>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            Questa sezione è attualmente in fase di preparazione. Presto troverai qui tutti i dettagli per entrare in contatto con Upupa Journal.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
